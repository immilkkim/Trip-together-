{
  "name": "trip-together-guest-spike",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "dev": "node scripts/check-config.mjs --dev && next dev",
    "build": "node scripts/check-config.mjs && next build --webpack",
    "typecheck": "tsc --noEmit",
