    "seed:prepare": "node scripts/prepare-demo.mjs"
  },
  "dependencies": { "next": "16.3.4", "react": "19.2.6", "react-dom": "19.2.6" },
  "devDependencies": { "typescript": "5.9.3", "@types/node": "22.19.19", "@types/react": "19.2.14", "@types/react-dom": "19.2.3", "@electric-sql/pglite": "0.5.10" }
}
